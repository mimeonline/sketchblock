COLLAB_SERVER_PORT=4513
COLLAB_ALLOWED_ORIGINS=http://localhost:4512
COLLAB_MAX_SNAPSHOT_BYTES=25000000
# Required. Must match the web app (APP_AUTH_SECRET or COLLAB_AUTH_SECRET). Production: >= 32 random chars.
COLLAB_AUTH_SECRET=
# Local experiments only (ignored in production): start without any auth.
# COLLAB_ALLOW_INSECURE_NO_AUTH=true
COLLAB_LOG_LEVEL=info
COLLAB_LOG_FORMAT=auto
COLLAB_PERSISTENCE_DRIVER=postgres
COLLAB_DATABASE_URL=postgresql://sketchblock:sketchblock-local@localhost:5432/sketchblock_collab
COLLAB_DATABASE_POOL_MAX=5
COLLAB_MAX_CLIENTS_PER_SESSION=24
COLLAB_MAX_ACTIVE_SESSIONS=200
COLLAB_HTTP_REQUESTS_PER_IP_PER_MINUTE=240
COLLAB_SOCKET_CONNECTS_PER_IP_PER_MINUTE=60
COLLAB_SOCKET_EVENTS_PER_SOCKET_PER_MINUTE=300
COLLAB_YJS_UPDATES_PER_SOCKET_PER_MINUTE=1800
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For; otherwise rate limits ignore that header.
COLLAB_TRUST_PROXY=false
# Reject Yjs updates that would grow a session document beyond this many bytes.
COLLAB_MAX_YJS_DOCUMENT_BYTES=25000000
# Mount Swagger UI at /docs. Off by default; enable only for trusted environments.
COLLAB_EXPOSE_API_DOCS=false
